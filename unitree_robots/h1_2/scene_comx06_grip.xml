<mujoco model="Unitree H1-2 SYM">
  <!-- High-friction contacts need the elliptic cone: the default pyramidal
       solver goes ill-conditioned at mu=2.5 — soft normals (feet sink ~2cm)
       and erratic tangentials ("feels slipperier"). Measured 2026-07-16:
       pyramidal 21.4mm mean penetration -> elliptic/impratio10 = 1.7mm. -->
  <option cone="elliptic" impratio="10"/>
  <include file="h1_2_comx06.xml" />
  <statistic center="1 0.7 1.5" extent="0.8" />
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-140" elevation="-30" />
  </visual>
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <!-- GRIP variant: rubber-on-cement floor (friction 2.5 vs MuJoCo default 1.0).
         Feet PIN instead of sliding -> the inward-squeeze (hip-roll grinding,
         2026-07-15 firmware-overload root cause) becomes VISIBLE in sim2sim. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="2.5 0.005 0.0001" />
  </worldbody>
</mujoco>
